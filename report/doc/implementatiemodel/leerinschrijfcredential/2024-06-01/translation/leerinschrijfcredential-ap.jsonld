    {
      "@id": "https://w3.org/2018/credentials#VerifiableCredential",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Een verifieerbare credential is een fraudebestendige credential met auteurschap dat cryptografisch kan worden geverifieerd. Verifieerbare credentials kunnen worden gebruikt om verifieerbare presentaties te maken, die ook cryptografisch kunnen worden geverifieerd. De claims in een credential kunnen over verschillende onderwerpen gaan."
      },
      "label": {
        "nl": "Verifieerbare Credential"
      },
      "ap-label-nl": {
        "nl": "Verifieerbare Credential"
      },
