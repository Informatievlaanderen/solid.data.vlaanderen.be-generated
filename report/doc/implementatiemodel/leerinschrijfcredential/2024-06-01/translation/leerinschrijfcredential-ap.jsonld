    {
      "@id": "https://w3id.org/security#proof",
      "@type": "http://www.w3.org/2002/07/owl#ObjectProperty",
      "name": "bewijs",
      "inpackage": "OTHER_PACKAGE",
      "definition": {
        "nl": "Het cryptografische bewijs dat kan worden gebruikt om fraude te detecteren en het auteurschap van een Credential of Presentatie te verifiëren. Deze eigenschap is geërfd van verifieerbare credentials."
      },
      "label": {
