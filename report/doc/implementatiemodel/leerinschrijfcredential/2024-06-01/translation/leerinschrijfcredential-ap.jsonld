    {
      "@id": "https://solid.data.vlaanderen.be/ns/leercredential#vrijgesteld",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "name": "vrijgesteld",
      "inpackage": "ACTIVE_PACKAGE",
      "usage": {
        "nl": "Dit betekent dat de student voor deze inschrijvingsonderdelen geen lessen moet volgen of geen examens moet afleggen. Deze studiepunten tellen niet mee als opgenomen."
      },
      "definition": {
        "nl": "Het aantal studiepunten van de inschrijving voor inschrijvingsonderdelen waarvoor de student een vrijstelling heeft gekregen a.d.h.v. eerder verworven kwalificaties of competenties."
      },
      "label": {
        "nl": "vrijgesteld"
      },
      "ap-label-nl": {
        "nl": "vrijgesteld"
      },
