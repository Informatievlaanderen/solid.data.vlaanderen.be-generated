          {
            "key": "label-nl",
            "value": "Europees Digitaal Credential",
            "note": "null"
          },
          {
            "key": "definition-nl",
            "value": "NOTE",
            "note": "Een reeks beweringen die door een uitgever in Europa worden gemaakt, gebruikmakend van Europese standaarden. Een Europees Digitaal Credential is een reeks van een of meer beweringen die kunnen worden gebruikt om aan te tonen dat de eigenaar bepaalde vaardigheden bezit of bepaalde leeruitkomsten heeft bereikt door middel van formeel, niet-formeel of informeel leren."
          },
          {
            "key": "uri",
            "value": "http://data.europa.eu/snb/model/elm/EuropeanDigitalCredential",
            "note": "null"
          }
        ],
        "Scope": "NOTHING"
      },
      "name": "Europees Digitaal Credential"
    },
