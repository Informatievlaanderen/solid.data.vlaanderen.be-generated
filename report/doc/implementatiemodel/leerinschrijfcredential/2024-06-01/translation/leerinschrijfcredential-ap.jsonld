    {
      "@id": "http://www.w3.org/ns/org#Site",
      "@type": "http://www.w3.org/2002/07/owl#Class",
      "inpackage": "OTHER_PACKAGE",
      "ap-usageNote-nl": {
        "nl": "Meestal zal de vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
      },
      "usage": {
        "nl": "Meestal zal de vestiging een fysieke locatie zijn. Niet-fysieke locaties worden echter niet uitgesloten,bv een virtueel kantoor met bijbehorend postnummer en telefonische receptie."
      },
      "definition": {
        "nl": "Een kantoor of ander pand waar een organisatie gevestigd is. Organisaties kunnen over meerdere vestigingen verspreid zijn en vestigingen kunnen op meerdere locaties slaan."
      },
      "label": {
        "nl": "Vestiging"
      },
      "ap-label-nl": {
        "nl": "Vestiging"
      },
      "ap-definition-nl": {
