    {
      "@id": "https://solid.data.vlaanderen.be/ns/leercredential#opgenomen",
      "@type": "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "name": "opgenomen",
      "inpackage": "ACTIVE_PACKAGE",
      "usage": {
        "nl": "Een student die zich inschrijft voor een modeltraject neemt 60 studiepunten op. Het minimum is 0 studiepunten, maar studenten kunnen ook meer dan 60 studiepunten opnemen. De waarde kan soms hoger dan 100 liggen. Indien de instelling, bij uitschrijving van een student, de studiepunten van bepaalde opleidingsonderdelen niet terug geeft, dan tellen deze ook mee als opgenomen. Indien de student vrijstellingen heeft, tellen deze studiepunten niet mee als opgenomen."
      },
      "definition": {
        "nl": "Het totaal aantal opgenomen studiepunten van de inschrijving."
      },
      "label": {
        "nl": "opgenomen"
      },
      "ap-label-nl": {
        "nl": "opgenomen"
      },
      "ap-definition-nl": {
        "nl": "Het totaal aantal opgenomen studiepunten van de inschrijving."
      },
      "extra": {
