@prefix dc: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://data.europa.eu/snb/model/elm/AwardingProcess> a rdfs:Class;
  rdfs:label "Toekenningsproces"@nl .

<http://data.europa.eu/snb/model/elm/Claim> a rdfs:Class;
  rdfs:label "Leerclaim"@nl .

<http://data.europa.eu/snb/model/elm/DisplayParameter> a rdfs:Class;
  rdfs:label "Voorstelling"@nl .

<http://data.europa.eu/snb/model/elm/EuropeanDigitalCredential> a rdfs:Class;
  rdfs:label "Europees Digitaal Credential"@nl .

<http://data.europa.eu/snb/model/elm/LearningAchievement> a rdfs:Class;
  rdfs:label "Leerprestatie"@nl .

<http://data.europa.eu/snb/model/elm/LearningAchievementSpecification> a rdfs:Class;
  rdfs:label "Leerprestatiespecificatie"@nl .

<http://data.europa.eu/snb/model/elm/LearningActivitySpecification> a rdfs:Class;
  rdfs:label "Leeractiviteitspecificatie"@nl .

<http://data.europa.eu/snb/model/elm/Qualification> a rdfs:Class;
  rdfs:label "Kwalificatie"@nl .

<http://data.europa.eu/snb/model/elm/Specification> a rdfs:Class;
  rdfs:label "Leerspecificatie"@nl .

skos:Concept a rdfs:Class;
  rdfs:label "Leerclaimtype"@nl,
    "Land"@nl,
    "Authenticiteit"@nl,
    "Leerprestatietype"@nl,
    "Leercredentialtype"@nl,
    "Onderwerp"@nl,
    "Taal"@nl,
    "Onderwijsniveau"@nl,
    "Studiegebied"@nl .

<https://w3.org/2018/credentials#VerifiableCredential> a rdfs:Class;
  rdfs:label "Verifieerbare Credential"@nl .

<https://w3id.org/security#Proof> a rdfs:Class;
  rdfs:label "Bewijs"@nl .

<https://data.vlaanderen.be/ns/leercredential#Leercredential> a owl:Class;
  rdfs:comment "Een reeks van een of meer beweringen over leerervaringen, gemaakt door een uitgever."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/leercredential>;
  rdfs:subClassOf <https://data.vlaanderen.be/ns/leercredential#Credential> .

<http://data.europa.eu/snb/model#ISCEDFCode> a rdf:Property;
  rdfs:label "studiegebied"@nl .

<http://data.europa.eu/snb/model/elm/awardedBy> a rdf:Property;
  rdfs:label "toegekend door"@nl .

<http://data.europa.eu/snb/model/elm/awardingDate> a rdf:Property;
  rdfs:label "toekenningsdatum"@nl .

<http://data.europa.eu/snb/model/elm/awards> a rdf:Property;
  rdfs:label "kent toe"@nl .

<http://data.europa.eu/snb/model/elm/displayParameter> a rdf:Property;
  rdfs:label "voorstelling"@nl .

<http://data.europa.eu/snb/model/elm/educationLevel> a rdf:Property;
  rdfs:label "onderwijsniveau"@nl .

<http://data.europa.eu/snb/model/elm/educationSubject> a rdf:Property;
  rdfs:label "onderwerp"@nl .

<http://data.europa.eu/snb/model/elm/influencedBy> a rdf:Property;
  rdfs:label "beinvloed door"@nl .

<http://data.europa.eu/snb/model/elm/influences> a rdf:Property;
  rdfs:label "beinvloedt"@nl .

<http://data.europa.eu/snb/model/elm/location> a rdf:Property;
  rdfs:label "locatie"@nl .

<http://data.europa.eu/snb/model/elm/primaryLanguage> a rdf:Property;
  rdfs:label "hoofdtaal"@nl .

<http://data.europa.eu/snb/model/elm/specifiedBy> a rdf:Property;
  rdfs:label "specificatie"@nl .

dc:language a rdf:Property;
  rdfs:label "taal"@nl,
    "onderwijstaal"@nl,
    "instructietaal"@nl .

dc:title a rdf:Property;
  rdfs:label "titel"@nl .

dc:type a rdf:Property;
  rdfs:label "type"@nl .

<http://www.w3.org/ns/adms#identifier> a rdf:Property;
  rdfs:label "identificator"@nl .

<https://data.vlaanderen.be/ns/leercredential#Credential> a owl:Class;
  rdfs:comment "Een credential is een reeks van een of meer beweringen gemaakt door een uitgever."@nl;
  rdfs:isDefinedBy <https://data.vlaanderen.be/ns/leercredential> .

<https://w3.org/2018/credentials#credentialSchema> a rdf:Property;
  rdfs:label "credentialschema"@nl .

<https://w3id.org/security#proof> a rdf:Property;
  rdfs:label "bewijs"@nl .

<https://www.w3.org/2018/credentials#issuanceDate> a rdf:Property;
  rdfs:label "uitgiftedatum"@nl .

<https://www.w3.org/2018/credentials#validFrom> a rdf:Property;
  rdfs:label "geldig van"@nl .

<https://www.w3.org/2018/credentials#validUntil> a rdf:Property;
  rdfs:label "vervaldatum"@nl .

<https://data.vlaanderen.be/ns/leercredential> a owl:Ontology;
  rdfs:label "leercredential"@en,
    "leercredential"@nl;
  dc:issued "TODO";
  dc:license "https://creativecommons.org/publicdomain/zero/1.0/",
    <https://data.vlaanderen.be/id/licentie/modellicentie-gratis-hergebruik/v1.0>;
