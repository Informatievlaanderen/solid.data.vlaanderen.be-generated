    <http://data.europa.eu/snb/model/elm/Qualification>,
    <http://data.europa.eu/snb/model/elm/Specification>,
    skos:Concept,
    <https://w3.org/2018/credentials#VerifiableCredential>,
    <https://w3id.org/security#Proof>,
    <https://www.w3.org/2018/credentials#validUntil>,
    <https://www.w3.org/2018/credentials#validFrom>,
    <https://www.w3.org/2018/credentials#issuanceDate>,
    <https://w3id.org/security#proof>,
    <https://w3.org/2018/credentials#credentialSchema>,
    <http://www.w3.org/ns/adms#identifier>,
    dc:type,
    dc:title,
    dc:language,
    <http://data.europa.eu/snb/model/elm/specifiedBy>,
    <http://data.europa.eu/snb/model/elm/primaryLanguage>,
    <http://data.europa.eu/snb/model/elm/location>,
    <http://data.europa.eu/snb/model/elm/influences>,
    <http://data.europa.eu/snb/model/elm/influencedBy>,
    <http://data.europa.eu/snb/model/elm/educationSubject>,
    <http://data.europa.eu/snb/model/elm/educationLevel>,
    <http://data.europa.eu/snb/model/elm/displayParameter>,
    <http://data.europa.eu/snb/model/elm/awards>,
    <http://data.europa.eu/snb/model/elm/awardingDate>,
    <http://data.europa.eu/snb/model/elm/awardedBy>,
    <http://data.europa.eu/snb/model#ISCEDFCode>;
  <http://www.w3.org/2001/02pd/rec54#editor> [
    a foaf:Person;
    schema:affiliation [
      foaf:homepage <https://www.vlaanderen.be/digitaal-vlaanderen>;
      foaf:name "Digitaal Vlaanderen"
    ];
    foaf:firstName "Solid Team";
