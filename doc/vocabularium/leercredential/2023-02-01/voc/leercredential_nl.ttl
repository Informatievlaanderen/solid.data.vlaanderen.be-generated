    <http://data.europa.eu/snb/model/elm/Claim>,
    <http://data.europa.eu/snb/model/elm/DisplayParameter>,
    <http://data.europa.eu/snb/model/elm/EuropeanDigitalCredential>,
    <http://data.europa.eu/snb/model/elm/LearningAchievement>,
